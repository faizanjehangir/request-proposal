# Optional. The default path also works without an .env file.
RFP_DB_PATH=.data/rfp.sqlite

# Defaults to fixture mode. Set all three values to opt into AI extraction.
# RFP_EXTRACTION_MODE=openai
# RFP_OPENAI_MODEL=your-structured-output-model
# OPENAI_API_KEY=

# The local AI Lab is enabled by default. Fixture mode needs no API key.
# RFP_V2_ENABLED=0
# RFP_V2_MODEL_MODE=openai
# RFP_V2_OPENAI_MODEL=your-structured-output-model

# Optional simulated kickoff slot. Use a future ISO timestamp with an explicit offset.
# RFP_KICKOFF_START=2027-01-04T10:00:00-05:00
# RFP_KICKOFF_TIMEZONE=America/Toronto

# Optional separate Turso database for hosted V2 proposals.
# RFP_V2_DATABASE_URL=
# RFP_V2_DATABASE_AUTH_TOKEN=
